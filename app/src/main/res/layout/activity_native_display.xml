<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <com.partpulse.displaylauncher.PdfPageView
        android:id="@+id/pdfCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111" />

    <!-- Notification overlay: image fills screen, text bar pinned to bottom -->
    <FrameLayout
        android:id="@+id/notificationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0d13"
        android:visibility="gone">

        <!-- Image: fills entire slide, edge to edge -->
        <ImageView
            android:id="@+id/notifImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Gradient scrim so text is readable over any image -->
        <View
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:background="@drawable/notif_scrim" />

        <!-- Text panel: pinned to bottom, overlaid on image -->
        <LinearLayout
            android:id="@+id/notifTextPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/notifTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#60a5fa"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/notifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#f0f4ff"
                android:textSize="38sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/notifBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#c8cfe8"
                android:textSize="20sp"
                android:lineSpacingExtra="4dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/notifDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7b82a8"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- No-image fallback: full dark panel (shown when notifImage has no bitmap) -->
        <LinearLayout
            android:id="@+id/notifImagePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1a1d27"
            android:paddingStart="80dp"
            android:paddingEnd="80dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/notifTagNoImg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#60a5fa"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/notifTitleNoImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#f0f4ff"
                android:textSize="52sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/notifBodyNoImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9ca3c8"
                android:textSize="26sp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="32dp" />

            <TextView
                android:id="@+id/notifDateNoImg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#5a6080"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Label pill: top-left floating -->
    <TextView
        android:id="@+id/hudLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Clock: top-right floating -->
    <TextView
        android:id="@+id/hudClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#88000000"
        android:textColor="#E0FFFFFF"
        android:textSize="11sp"
        android:fontFeatureSettings="tnum" />

    <LinearLayout
        android:id="@+id/dotRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center" />

    <View
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="#3b82f6"
        android:scaleX="0"
        android:transformPivotX="0dp" />

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        style="?android:attr/progressBarStyleLarge" />

</FrameLayout>
