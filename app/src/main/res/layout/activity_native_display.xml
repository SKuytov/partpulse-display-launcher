<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <com.partpulse.displaylauncher.PdfPageView
        android:id="@+id/pdfCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111" />

    <FrameLayout
        android:id="@+id/notificationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0d13"
        android:visibility="gone">

        <!-- WITH IMAGE layout: vertical split — image top 45%, text bottom 55% -->
        <LinearLayout
            android:id="@+id/notifWithImageLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Top image strip — 45% of screen height -->
            <ImageView
                android:id="@+id/notifImage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="45"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Bottom text panel — 55% of screen height -->
            <LinearLayout
                android:id="@+id/notifTextPanel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="55"
                android:orientation="vertical"
                android:background="#0b0d13"
                android:paddingStart="64dp"
                android:paddingEnd="64dp"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notifTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#60a5fa"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/notifTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#f0f4ff"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/notifBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#c0c8e8"
                    android:textSize="20sp"
                    android:lineSpacingExtra="4dp"
                    android:paddingBottom="14dp" />

                <TextView
                    android:id="@+id/notifDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#6b7280"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- NO IMAGE layout: full-screen dark panel with centered text -->
        <LinearLayout
            android:id="@+id/notifImagePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#1a1d27"
            android:paddingStart="80dp"
            android:paddingEnd="80dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/notifTagNoImg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#60a5fa"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/notifTitleNoImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#f0f4ff"
                android:textSize="52sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/notifBodyNoImg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9ca3c8"
                android:textSize="26sp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="32dp" />

            <TextView
                android:id="@+id/notifDateNoImg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#5a6080"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Label pill: top-left floating -->
    <TextView
        android:id="@+id/hudLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Clock: top-right floating -->
    <TextView
        android:id="@+id/hudClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="#88000000"
        android:textColor="#E0FFFFFF"
        android:textSize="11sp"
        android:fontFeatureSettings="tnum" />

    <LinearLayout
        android:id="@+id/dotRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center" />

    <View
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="#3b82f6"
        android:scaleX="0"
        android:transformPivotX="0dp" />

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        style="?android:attr/progressBarStyleLarge" />

</FrameLayout>
