<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen WebView — must be focusable so D-pad events reach it -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Floating toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="#CC1A1A2E"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PartPulse"
            android:textColor="#00B4D8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="http://192.168.0.62:5000/#/display"
            android:textColor="#AAAACC"
            android:textSize="12sp" />

        <!-- Refresh button — TV-focusable -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_toolbar_selector"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#00B4D8"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusRight="@id/btnSettings"
            android:contentDescription="Refresh" />

        <!-- Settings button — TV-focusable -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_toolbar_selector"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#00B4D8"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusLeft="@id/btnRefresh"
            android:contentDescription="Settings" />

    </LinearLayout>

</FrameLayout>
